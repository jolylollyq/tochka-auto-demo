---
import data from '../../content/site.json';

const baseUrl = import.meta.env.BASE_URL;
const imageUrl = (value) => `${baseUrl}${value.replace(/^\//, '')}`;
const nav = [
  { id: 'overview', label: 'Главная', icon: '⌂' },
  { id: 'content', label: 'Страница сайта', icon: '▤' },
  { id: 'services', label: 'Услуги', icon: '⚙', count: data.services.length },
  { id: 'works', label: 'Примеры работ', icon: '▧', count: data.cases.length },
  { id: 'contacts', label: 'Контакты', icon: '⌖' },
];
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <meta name="theme-color" content="#202720" />
    <title>Админ-панель · {data.name}</title>
  </head>
  <body data-base-url={baseUrl}>
    <div class="admin-shell">
      <aside class="sidebar">
        <a class="brand" href="#overview" aria-label="ТОЧКА — админ-панель">
          <span class="brand-mark">т.</span><span class="brand-name">ТОЧКА<small>АВТОСЕРВИС</small></span>
        </a>
        <div class="workspace"><span class="workspace-avatar">Т</span><span><b>Автосервис</b><small>рабочее пространство</small></span><span class="chevron">⌄</span></div>
        <p class="nav-caption">УПРАВЛЕНИЕ</p>
        <nav class="side-nav" aria-label="Разделы панели">
          {nav.map((item, index) => <button class:list={['nav-link', { active: index === 0 }]} type="button" data-target={item.id} aria-current={index === 0 ? 'page' : undefined}><span class="nav-icon">{item.icon}</span><span>{item.label}</span>{item.count && <span class="nav-count" data-count-for={item.id}>{item.count}</span>}</button>)}
        </nav>
        <div class="sidebar-bottom">
          <div class="demo-mark"><i></i> ЛОКАЛЬНЫЙ ПРОСМОТР</div>
          <p>Правки видны только в этой вкладке и сбрасываются при обновлении.</p>
          <a class="public-link" href={baseUrl} target="_blank" rel="noopener">Открыть сайт <span>↗</span></a>
        </div>
      </aside>

      <main class="main-area">
        <header class="topbar">
          <div class="breadcrumbs"><span>ТОЧКА</span><i>/</i><b id="crumb-label">Главная</b></div>
          <div class="top-actions"><a class="preview-link" href={baseUrl} target="_blank" rel="noopener">Предпросмотр сайта <b>↗</b></a><button class="apply-button" id="apply-all" type="button">Применить изменения <span>✓</span></button></div>
        </header>

        <div class="content-wrap">
          <section class="page-panel active-panel" id="panel-overview" data-panel="overview">
            <div class="page-heading"><div><p class="eyebrow"><i></i> АДМИНИСТРАТИВНАЯ ПАНЕЛЬ</p><h1>Добро пожаловать!</h1><p class="subheading">Управляйте содержимым сайта автосервиса в одном месте.</p></div><button class="button-secondary" type="button" data-go="content">✎ <span>Настроить главную</span></button></div>
            <div class="notice"><span class="notice-icon">✳</span><div><b>Попробуйте изменить сайт</b><span>Поля можно редактировать, а услуги и примеры работ — добавлять и удалять.</span></div><button class="notice-close" type="button" aria-label="Скрыть подсказку">×</button></div>
            <div class="metric-grid">
              <button class="metric-card" data-go="services" type="button"><span class="metric-symbol olive">⚙</span><span class="metric-copy"><b id="metric-services">{data.services.length}</b><small>Услуг на сайте</small></span><span class="metric-arrow">↗</span></button>
              <button class="metric-card" data-go="works" type="button"><span class="metric-symbol orange">▧</span><span class="metric-copy"><b id="metric-works">{data.cases.length}</b><small>Примеров работ</small></span><span class="metric-arrow">↗</span></button>
              <button class="metric-card" data-go="contacts" type="button"><span class="metric-symbol blue">⌖</span><span class="metric-copy"><b>Контакты</b><small>Данные автосервиса</small></span><span class="metric-arrow">↗</span></button>
            </div>
            <div class="overview-grid">
              <article class="card quick-card"><div class="card-heading"><div><p class="eyebrow">БЫСТРЫЙ ДОСТУП</p><h2>Что хотите изменить?</h2></div><span class="heading-icon">✳</span></div>
                <button class="quick-row" type="button" data-go="content"><span class="quick-icon">▤</span><span><b>Текст и первый экран</b><small>Название, заголовок, описание и фото</small></span><i>→</i></button>
                <button class="quick-row" type="button" data-go="services"><span class="quick-icon orange-bg">⚙</span><span><b>Список услуг</b><small>Описания, цены и новые позиции</small></span><i>→</i></button>
                <button class="quick-row" type="button" data-go="works"><span class="quick-icon blue-bg">▧</span><span><b>Примеры работ</b><small>Добавьте карточку для портфолио</small></span><i>→</i></button>
                <button class="quick-row" type="button" data-go="contacts"><span class="quick-icon">⌖</span><span><b>Контактные данные</b><small>Телефон, адрес и график</small></span><i>→</i></button>
              </article>
              <article class="card preview-card"><div class="card-heading"><div><p class="eyebrow">КАК ЭТО ВЫГЛЯДИТ</p><h2>Мини-превью сайта</h2></div><a class="subtle-link" href={baseUrl} target="_blank" rel="noopener">Открыть ↗</a></div>
                <div class="mini-site"><div class="mini-top"><b>т.</b><span>АВТОСЕРВИС</span><i>☰</i></div><div class="mini-photo" style={`background-image:url('${imageUrl(data.heroImage)}')`}><div class="mini-photo-shade"></div><div class="mini-caption"><small>НЕЗАВИСИМЫЙ АВТОСЕРВИС</small><b data-preview="headline">{data.headline}</b><span data-preview="address">{data.address}</span><button type="button" data-go="contacts">Записаться →</button></div></div></div>
                <p class="preview-hint"><i></i> Внесите правки в панели и посмотрите их здесь.</p>
              </article>
            </div>
            <div class="bottom-row"><span></span><button type="button" class="text-button" id="reset-all">Сбросить макет <span>↺</span></button></div>
          </section>

          <section class="page-panel" id="panel-content" data-panel="content" hidden>
            <div class="page-heading"><div><p class="eyebrow"><i></i> РЕДАКТОР СТРАНИЦЫ</p><h1>Главная страница</h1><p class="subheading">Поменяйте текст и сразу посмотрите, как он будет выглядеть.</p></div><button class="apply-button mobile-apply" data-apply type="button">Применить изменения ✓</button></div>
            <div class="editor-layout"><article class="card editor-card"><div class="card-heading"><div><p class="eyebrow">ОСНОВНАЯ ИНФОРМАЦИЯ</p><h2>Первый экран сайта</h2></div><span class="editing-label">✎ Редактирование</span></div>
              <label class="field"><span>Название компании</span><input data-field="name" value={data.name} /></label>
              <label class="field"><span>Короткая подпись</span><input data-field="eyebrow" value={data.eyebrow} /></label>
              <label class="field"><span>Заголовок</span><input data-field="headline" value={data.headline} /><small>Основной крупный текст на первом экране.</small></label>
              <label class="field"><span>Описание</span><textarea rows="4" data-field="intro">{data.intro}</textarea></label>
              <label class="field"><span>Фоновое фото</span><select data-field="heroImage"><option value={data.heroImage}>Фото автосервиса</option><option value="/images/brakes.webp">Тормозная система</option><option value="/images/engine.webp">Подкапотное пространство</option><option value="/images/suspension.webp">Подвеска автомобиля</option></select></label>
              <div class="editor-footer"><button class="button-secondary" type="button" data-reset-fields="content">Вернуть исходный текст</button><button class="apply-button" data-apply type="button">Применить <span>✓</span></button></div>
            </article><article class="card live-preview"><div class="card-heading"><div><p class="eyebrow">ПРЕДПРОСМОТР</p><h2>Первый экран</h2></div><span class="live-badge"><i></i> Обновляется</span></div><div class="large-preview" style={`background-image:url('${imageUrl(data.heroImage)}')`} data-hero-preview><div class="large-shade"></div><div class="large-brand"><b>т.</b><span data-preview="name">{data.name}</span></div><div class="large-caption"><span data-preview="eyebrow">{data.eyebrow}</span><h3 data-preview="headline">{data.headline}</h3><p data-preview="intro">{data.intro}</p><button type="button" data-go="contacts">Записаться</button></div><div class="large-address"><span>⌖</span><b data-preview="address">{data.address}</b></div></div><p class="preview-caption">Макет меняется прямо здесь. Публичная страница остаётся прежней.</p></article></div>
          </section>

          <section class="page-panel" id="panel-services" data-panel="services" hidden>
            <div class="page-heading"><div><p class="eyebrow"><i></i> СОДЕРЖАНИЕ САЙТА</p><h1>Услуги</h1><p class="subheading">Редактируйте карточки или добавляйте новые.</p></div><button class="apply-button" data-apply type="button">Применить изменения <span>✓</span></button></div>
            <div class="toolbar"><div><b id="services-count">{data.services.length} услуг</b><span>· макет отображения раздела на сайте</span></div><button class="add-button" id="add-service" type="button"><b>＋</b> Добавить услугу</button></div>
            <div class="editable-list" id="services-list"></div>
            <div class="editor-note"><span>i</span> Нажмите на поле, чтобы изменить его.</div>
          </section>

          <section class="page-panel" id="panel-works" data-panel="works" hidden>
            <div class="page-heading"><div><p class="eyebrow"><i></i> ПОРТФОЛИО</p><h1>Примеры работ</h1><p class="subheading">Карточки работ в портфолио автосервиса.</p></div><button class="apply-button" data-apply type="button">Применить изменения <span>✓</span></button></div>
            <div class="toolbar"><div><b id="works-count">{data.cases.length} карточки</b><span>· можно добавить свою</span></div><button class="add-button" id="add-work" type="button"><b>＋</b> Добавить работу</button></div>
            <div class="works-editor-list" id="works-list"></div>
            <div class="editor-note"><span>i</span> Добавьте карточку, поменяйте описание или удалите ненужную. Изменения существуют только в этой вкладке.</div>
          </section>

          <section class="page-panel" id="panel-contacts" data-panel="contacts" hidden>
            <div class="page-heading"><div><p class="eyebrow"><i></i> ДАННЫЕ АВТОСЕРВИСА</p><h1>Контакты</h1><p class="subheading">Обновите контактные данные и посмотрите результат.</p></div><button class="apply-button" data-apply type="button">Применить изменения <span>✓</span></button></div>
            <div class="contacts-layout"><article class="card editor-card"><div class="card-heading"><div><p class="eyebrow">КАК С ВАМИ СВЯЗАТЬСЯ</p><h2>Контактная информация</h2></div><span class="editing-label">✎ Редактирование</span></div>
              <label class="field"><span>Номер телефона</span><input data-field="phone" value={data.phone} /></label>
              <label class="field"><span>Адрес автосервиса</span><input data-field="address" value={data.address} /></label>
              <label class="field"><span>График работы</span><input data-field="hours" value={data.hours} /></label>
              <label class="field"><span>Ссылка на ВКонтакте</span><input data-field="vk" placeholder="https://vk.com/..." /></label>
              <label class="field"><span>Ссылка на Telegram</span><input data-field="telegram" placeholder="https://t.me/..." /></label>
              <div class="editor-footer"><button class="button-secondary" type="button" data-reset-fields="contacts">Вернуть исходные данные</button><button class="apply-button" data-apply type="button">Применить <span>✓</span></button></div>
            </article><article class="card contact-preview"><div class="card-heading"><div><p class="eyebrow">ПРЕДПРОСМОТР</p><h2>Контакты в подвале сайта</h2></div><span class="live-badge"><i></i> Обновляется</span></div><div class="contact-preview-body"><div class="contact-brand"><b>т.</b><span data-preview="name">{data.name}</span></div><div class="contact-preview-row"><span>ПОЗВОНИТЬ</span><b data-preview="phone">{data.phone}</b></div><div class="contact-preview-row"><span>МЫ НАХОДИМСЯ</span><b data-preview="address">{data.address}</b></div><div class="contact-preview-row"><span>РАБОТАЕМ</span><b data-preview="hours">{data.hours}</b></div><div class="social-preview"><button type="button" disabled>ВКонтакте ↗</button><button type="button" disabled>Telegram ↗</button></div></div></article></div>
          </section>

          <footer class="page-footer"><span>ТОЧКА · панель управления</span></footer>
        </div>
      </main>
    </div>
    <div class="toast" id="toast" role="status" aria-live="polite"><span>✓</span><div><b>Готово!</b><small>Изменения применены в панели</small></div><button type="button" aria-label="Закрыть уведомление">×</button></div>
    <script type="application/json" id="admin-seed" set:html={JSON.stringify(data)}></script>
    <script>
      const seed = JSON.parse(document.querySelector('#admin-seed').textContent);
      const siteBase = document.body.dataset.baseUrl;
      const clone = (value) => JSON.parse(JSON.stringify(value));
      let state = clone(seed);
      const labels = { overview: 'Главная', content: 'Страница сайта', services: 'Услуги', works: 'Примеры работ', contacts: 'Контакты' };
      const toast = document.querySelector('#toast');
      let toastTimer;

      function showToast(title = 'Готово!', message = 'Изменения применены в панели') {
        toast.querySelector('b').textContent = title;
        toast.querySelector('small').textContent = message;
        toast.classList.add('show');
        clearTimeout(toastTimer);
        toastTimer = setTimeout(() => toast.classList.remove('show'), 3300);
      }
      function goTo(id) {
        document.querySelectorAll('[data-panel]').forEach((panel) => { panel.hidden = panel.dataset.panel !== id; panel.classList.toggle('active-panel', panel.dataset.panel === id); });
        document.querySelectorAll('.nav-link').forEach((button) => { const active = button.dataset.target === id; button.classList.toggle('active', active); active ? button.setAttribute('aria-current', 'page') : button.removeAttribute('aria-current'); });
        document.querySelector('#crumb-label').textContent = labels[id] || labels.overview;
        window.scrollTo({ top: 0, behavior: 'smooth' });
      }
      document.querySelectorAll('[data-target]').forEach((button) => button.addEventListener('click', () => goTo(button.dataset.target)));
      document.querySelectorAll('[data-go]').forEach((button) => button.addEventListener('click', () => goTo(button.dataset.go)));
      document.querySelectorAll('[data-field]').forEach((field) => field.addEventListener('input', () => {
        const key = field.dataset.field;
        state[key] = field.value;
        document.querySelectorAll(`[data-preview="${key}"]`).forEach((node) => { node.textContent = field.value || `Ваш ${key === 'headline' ? 'заголовок' : key}`; });
        if (key === 'heroImage') document.querySelectorAll('[data-hero-preview]').forEach((node) => { node.style.backgroundImage = `url('${siteBase}${field.value.replace(/^\//, '')}')`; });
      }));

      const esc = (value = '') => String(value).replace(/[&<>"']/g, (char) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[char]);
      function renderServices() {
        const list = document.querySelector('#services-list');
        list.innerHTML = state.services.map((service, index) => `<article class="editable-card service-edit-card" data-index="${index}">
          <div class="item-number">${String(index + 1).padStart(2, '0')}</div><div class="editable-fields">
            <label class="field"><span>Название услуги</span><input data-service="title" value="${esc(service.title)}" placeholder="Например, шиномонтаж"></label>
            <label class="field"><span>Краткое описание</span><textarea data-service="description" rows="2" placeholder="Что входит в услугу">${esc(service.description)}</textarea></label>
            <div class="two-fields"><label class="field"><span>Цена</span><input data-service="price" value="${esc(service.price)}" placeholder="от 1 000 ₽"></label><label class="field"><span>Время</span><input data-service="time" value="${esc(service.time)}" placeholder="от 1 часа"></label></div>
          </div><button type="button" class="delete-button" data-delete-service="${index}" aria-label="Удалить услугу">×</button>
        </article>`).join('') || '<div class="empty-state"><b>Здесь пока пусто</b><span>Нажмите «Добавить услугу», чтобы создать первую карточку.</span></div>';
        document.querySelector('#services-count').textContent = `${state.services.length} ${plural(state.services.length, 'услуга', 'услуги', 'услуг')}`;
        document.querySelector('#metric-services').textContent = state.services.length;
        document.querySelector('[data-count-for="services"]').textContent = state.services.length;
        list.querySelectorAll('[data-service]').forEach((field) => field.addEventListener('input', () => { state.services[Number(field.closest('[data-index]').dataset.index)][field.dataset.service] = field.value; }));
        list.querySelectorAll('[data-delete-service]').forEach((button) => button.addEventListener('click', () => { state.services.splice(Number(button.dataset.deleteService), 1); renderServices(); showToast('Карточка удалена', 'Удаление видно только в этой вкладке'); }));
      }
      function renderWorks() {
        const list = document.querySelector('#works-list');
        list.innerHTML = state.cases.map((item, index) => `<article class="editable-card work-edit-card" data-work-index="${index}">
          <div class="work-thumb" style="background-image:url('${esc(`${siteBase}${(item.image || seed.heroImage).replace(/^\//, '')}`)}')">▧</div><div class="editable-fields">
            <div class="two-fields"><label class="field"><span>Название работы</span><input data-work="title" value="${esc(item.title)}" placeholder="Например, замена масла"></label><label class="field"><span>Категория</span><input data-work="category" value="${esc(item.category)}" placeholder="Обслуживание"></label></div>
            <div class="two-fields"><label class="field"><span>Автомобиль</span><input data-work="car" value="${esc(item.car)}" placeholder="Седан · 2020"></label><label class="field"><span>Стоимость</span><input data-work="price" value="${esc(item.price)}" placeholder="от 5 000 ₽"></label></div>
            <label class="field"><span>Описание результата</span><textarea data-work="result" rows="2" placeholder="Что было сделано">${esc(item.result || item.solution || '')}</textarea></label>
          </div><button type="button" class="delete-button" data-delete-work="${index}" aria-label="Удалить работу">×</button>
        </article>`).join('') || '<div class="empty-state"><b>Портфолио пока пустое</b><span>Добавьте пример работы.</span></div>';
        document.querySelector('#works-count').textContent = `${state.cases.length} ${plural(state.cases.length, 'карточка', 'карточки', 'карточек')}`;
        document.querySelector('#metric-works').textContent = state.cases.length;
        document.querySelector('[data-count-for="works"]').textContent = state.cases.length;
        list.querySelectorAll('[data-work]').forEach((field) => field.addEventListener('input', () => { state.cases[Number(field.closest('[data-work-index]').dataset.workIndex)][field.dataset.work] = field.value; }));
        list.querySelectorAll('[data-delete-work]').forEach((button) => button.addEventListener('click', () => { state.cases.splice(Number(button.dataset.deleteWork), 1); renderWorks(); showToast('Карточка удалена', 'Удаление видно только в этой вкладке'); }));
      }
      function plural(number, one, few, many) { const mod10 = number % 10; const mod100 = number % 100; return mod10 === 1 && mod100 !== 11 ? one : mod10 >= 2 && mod10 <= 4 && (mod100 < 12 || mod100 > 14) ? few : many; }
      document.querySelector('#add-service').addEventListener('click', () => { state.services.push({ title: '', description: '', price: '', time: '' }); renderServices(); document.querySelector('#services-list .editable-card:last-child input').focus(); });
      document.querySelector('#add-work').addEventListener('click', () => { state.cases.push({ title: '', category: 'Новая работа', car: '', price: '', result: '', image: seed.heroImage }); renderWorks(); document.querySelector('#works-list .editable-card:last-child input').focus(); });
      document.querySelectorAll('[data-apply], #apply-all').forEach((button) => button.addEventListener('click', () => showToast('Изменения применены', 'Изменения видны только в этой панели')));
      document.querySelector('#reset-all').addEventListener('click', () => { window.location.reload(); });
      document.querySelector('.notice-close').addEventListener('click', () => document.querySelector('.notice').remove());
      toast.querySelector('button').addEventListener('click', () => toast.classList.remove('show'));
      document.querySelectorAll('[data-reset-fields]').forEach((button) => button.addEventListener('click', () => {
        const fields = button.dataset.resetFields === 'content' ? ['name', 'eyebrow', 'headline', 'intro', 'heroImage'] : ['phone', 'address', 'hours', 'vk', 'telegram'];
        fields.forEach((key) => { const field = document.querySelector(`[data-field="${key}"]`); if (field) { field.value = seed[key] || ''; field.dispatchEvent(new Event('input', { bubbles: true })); } });
        showToast('Исходные данные восстановлены', 'Изменения видны только в этой панели');
      }));
      renderServices();
      renderWorks();
    </script>
  </body>
</html>

<style is:global>
  :root{font-family:Inter,"Segoe UI",Arial,sans-serif;color:#242a24;background:#f4f5f0;font-synthesis:none;text-rendering:optimizeLegibility;font-optical-sizing:auto}*{box-sizing:border-box}body{margin:0;min-width:320px}button,input,textarea,select{font:inherit}button{cursor:pointer}a{color:inherit;text-decoration:none}.admin-shell{min-height:100vh;display:grid;grid-template-columns:248px minmax(0,1fr)}
