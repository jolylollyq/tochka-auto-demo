---
import data from '../content/site.json';
import '../styles/global.css';
const baseUrl = import.meta.env.BASE_URL;
const assetUrl = (path) => `${baseUrl}${path.replace(/^\//, '')}`;
const casesWithBase = data.cases.map((item) => ({ ...item, image: assetUrl(item.image) }));
---
<!doctype html>
<html lang="ru">
<head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="description" content="ТОЧКА — демонстрационный сайт вымышленного автосервиса. Диагностика, обслуживание и ремонт с понятным подходом."/><meta name="robots" content="noindex,nofollow"/><meta name="theme-color" content="#222522"/><link rel="icon" type="image/svg+xml" href={assetUrl('/favicon.svg')}/><title>{data.name} — автосервис с понятным подходом · Демо</title></head>
<body>
<a class="skip" href="#main">К содержимому</a>
<div class="demo-bar"><span>КОНЦЕПТ / 2026</span><span>Вымышленный автосервис. Настоящее внимание к деталям.</span><a href="#about-demo">О демо <span aria-hidden="true">↗</span></a></div>
<header class="header"><a class="brand" href="#" aria-label={`${data.name} — на главную`}><span class="brand-mark" aria-hidden="true">↗</span><span>{data.name}<small>АВТОСЕРВИС</small></span></a><nav id="navigation" aria-label="Основная навигация"><a href="#services">Услуги</a><a href="#works">Наши работы</a><a href="#approach">Подход</a><a href="#contacts">Контакты</a></nav><a class="header-cta" href="#booking">Записаться <span aria-hidden="true">↗</span></a><button class="menu-toggle" aria-label="Открыть меню" aria-controls="navigation" aria-expanded="false"><span></span><span></span></button></header>
<main id="main">
<section class="hero"><div class="hero-copy"><p class="eyebrow"><i></i>{data.eyebrow}</p><h1>{data.headline}</h1><p class="hero-intro">{data.intro}</p><div class="hero-actions"><a class="button orange" href="#booking">Обсудить мой автомобиль <span aria-hidden="true">↗</span></a><a class="text-link" href="#works">Посмотреть работы <span aria-hidden="true">↓</span></a></div><div class="hero-foot"><span><b>Сначала объясняем.</b><br/>Потом ремонтируем.</span><span class="hero-coordinate">ТОЧНОСТЬ В ДЕТАЛЯХ<br/>УВЕРЕННОСТЬ В ДВИЖЕНИИ</span></div></div><div class="hero-visual"><img src={assetUrl(data.heroImage)} alt="Графитовый автомобиль в аккуратной современной мастерской" width="1672" height="941" fetchpriority="high"/><div class="image-top"><span>ТОЧКА ОБСЛУЖИВАНИЯ</span><span>ДЕМО / AI IMAGE</span></div><div class="image-bottom"><span class="crosshair" aria-hidden="true">+</span><p>Ваш автомобиль.<br/><strong>В центре внимания.</strong></p><a href="#approach" aria-label="Узнать о подходе" class="round-link">↘</a></div></div></section>
<div class="trust-strip"><p><span>01</span> Стоимость до начала работ</p><p><span>02</span> Фото и объяснение ремонта</p><p><span>{String(data.cases.length).padStart(2,'0')}</span> Только согласованные работы</p></div>
<section id="services" class="section services"><div class="section-heading reveal"><div><p class="eyebrow">01 / ЧТО МЫ ДЕЛАЕМ</p><h2>От первого сигнала<br/>до уверенной поездки.</h2></div><p class="section-intro">Регулярное обслуживание и ремонт.<br/>Начинаем с причины, подбираем решение<br class="desktop"/> и объясняем каждый шаг.</p></div><div class="service-grid">{data.services.map((service,i)=><details class="service reveal"><summary><span class="service-number">/ {String(i+1).padStart(2,'0')}</span><span class="service-title">{service.title}</span><span class="service-description">{service.description}</span><span class="service-bottom"><b>{service.price}</b><span class="plus" aria-hidden="true">+</span></span></summary><div class="service-details"><p>{service.details}</p><span>{service.time} · стоимость работ без запчастей</span><a href="#booking" data-service={service.title}>Выбрать услугу ↗</a></div></details>)}</div><p class="fine-print">Цены и сроки иллюстративные. Итоговая смета в реальном сервисе формируется после диагностики.</p></section>
<section id="approach" class="approach section"><div class="approach-lead reveal"><p class="eyebrow">02 / НАШ ПОДХОД</p><h2>Без сложных слов.<br/>Без неприятных<br/><em>сюрпризов.</em></h2><p>Хороший сервис начинается с разговора. Вы рассказываете, что беспокоит. Мы слушаем, проверяем и предлагаем понятный план.</p><a class="text-link" href="#booking">Давайте начнём с разговора <span>↗</span></a></div><div class="steps">{[{n:'01',title:'Разбираемся в задаче',text:'Уточняем симптомы и историю обслуживания. Проверяем автомобиль, чтобы найти причину, а не предполагать.'},{n:'02',title:'Согласуем решение',text:'Показываем, что нашли. Обсуждаем работы, запчасти, стоимость и срок. Решение остаётся за вами.'},{n:'03',title:'Делаем и проверяем',text:'Выполняем согласованные работы. Проверяем результат и объясняем, на что обратить внимание дальше.'}].map(s=><div class="step reveal"><span>{s.n}</span><div><h3>{s.title}</h3><p>{s.text}</p></div><span class="step-arrow" aria-hidden="true">↗</span></div>)}</div></section>
<section id="works" class="section works"><div class="section-heading reveal"><div><p class="eyebrow">03 / ИЗ РЕМЗОНЫ</p><h2>За каждым ремонтом<br/>есть своя история.</h2></div><p class="section-intro">Задача. Решение. Результат.<br/>Примеры того, как может выглядеть<br/>работа с вашим автомобилем.</p></div><div class="filters" aria-label="Фильтр примеров работ">{['Все работы', ...new Set(data.cases.map(item => item.category))].map((f,i)=><button data-filter={f} aria-pressed={i===0}>{f}{i===0&&<span>{String(data.cases.length).padStart(2,'0')}</span>}</button>)}</div><div class="work-grid">{data.cases.map((item,i)=><article class="work-card reveal" data-category={item.category}><button class="work-open" data-case={i} aria-label={`Подробнее: ${item.title}`}><div class="work-image"><img src={assetUrl(item.image)} alt={item.alt} width="1536" height="1024" loading="lazy"/><span class="work-tag">{item.category}</span><span class="work-arrow" aria-hidden="true">↗</span></div><div class="work-caption"><p class="eyebrow">{item.car}</p><h3>{item.title}</h3><div class="work-meta"><span>{item.time}</span><span>{item.price} <small>за работы</small></span></div></div></button></article>)}</div><p class="fine-print">Демонстрационные кейсы. Сюжеты вымышлены, изображения созданы с помощью ИИ.</p></section>
<section class="manifesto"><span class="manifesto-symbol" aria-hidden="true">↗</span><div><p class="eyebrow">ВЫ ЗАНИМАЕТЕСЬ СВОИМИ ПЛАНАМИ.</p><h2>Мы заботимся о том,<br/>чтобы вы до них доехали.</h2></div><a class="round-link" href="#booking" aria-label="Перейти к записи">↗</a></section>
<section class="section faq"><div class="reveal"><p class="eyebrow">04 / ЕСТЬ ВОПРОС</p><h2>Лучше спросить<br/>заранее.</h2><p class="section-intro">Несколько вещей, которые полезно<br/>знать перед первым визитом.</p></div><div class="faq-list">{data.faq.map(f=><details class="reveal"><summary>{f.question}<span aria-hidden="true">+</span></summary><p>{f.answer}</p></details>)}</div></section>
<section id="booking" class="section booking"><div class="booking-copy reveal"><p class="eyebrow">05 / НАЧНЁМ С ЗНАКОМСТВА</p><h2>Что беспокоит<br/>ваш автомобиль?</h2><p>Пара деталей поможет мастеру подготовиться к разговору. Можно описать проблему своими словами.</p><div class="booking-note"><span aria-hidden="true">↗</span><div><b>Сейчас это демо</b><p>Форма показывает сценарий записи. Данные никуда не отправляются и не сохраняются. Используйте вымышленные данные.</p></div></div></div><form id="booking-form"><div class="form-grid"><label>Как к вам обращаться<input name="name" placeholder="Например, Алексей" required maxlength="60" autocomplete="off"/></label><label>Телефон для связи<input name="phone" type="tel" placeholder="+7 (000) 000-00-00" required pattern="[+0-9\(\)\s\-]{10,22}" maxlength="22" autocomplete="off" title="Введите от 10 до 22 символов: цифры, пробелы, скобки, + или дефис"/></label><label>Ваш автомобиль<input name="car" placeholder="Марка, модель, год" maxlength="100"/></label><label>Что нужно сделать<select name="service"><option value="">Помогите разобраться</option>{data.services.map(s=><option>{s.title}</option>)}</select></label></div><label>Несколько слов о задаче <span class="optional">необязательно</span><textarea name="message" placeholder="Например, появился стук при повороте руля" rows="3" maxlength="1500"></textarea></label><button type="submit" class="button orange">Проверить демо-запись <span aria-hidden="true">↗</span></button><p class="form-legal">Это не запись в реальный автосервис. Контакты на сайте вымышлены.</p><div id="form-result" role="status" tabindex="-1" hidden><b>Вот так выглядит следующий шаг.</b><p>В рабочей версии заявка поступит мастеру, и он свяжется с вами для согласования времени. Сейчас данные не отправлены, запись не создана.</p><button type="button" id="form-reset">Заполнить ещё раз ↗</button></div></form></section>
<section id="contacts" class="contacts section"><div><p class="eyebrow">06 / ТОЧКА НА КАРТЕ</p><h2>Будем рядом.</h2><p class="contact-phone">{data.phone}</p><span class="fine-print">Номер-заглушка · звонки недоступны</span><div class="contact-details"><p><span>АДРЕС ДЛЯ ПРИМЕРА</span>{data.address}</p><p><span>РЕЖИМ РАБОТЫ</span>{data.hours}</p></div></div><div class="map-art" role="img" aria-label="Схематичная карта вымышленного адреса, не предназначена для навигации"><div class="map-road road-one"></div><div class="map-road road-two"></div><div class="map-road road-three"></div><span class="map-street">УЛ. МОТОРНАЯ</span><div class="map-pin"><span>↗</span>{data.name}<small>ВЫ НА МЕСТЕ</small></div><span class="map-caption">СХЕМА ДЛЯ ПРИМЕРА · НЕ РЕАЛЬНАЯ КАРТА</span></div></section>
</main>
<footer id="about-demo"><div class="footer-top"><a class="brand" href="#"><span class="brand-mark" aria-hidden="true">↗</span><span>{data.name}<small>АВТОСЕРВИС</small></span></a><p>Точность в деталях.<br/>Уверенность в движении.</p><a href="#" class="text-link">Наверх ↑</a></div><div class="footer-bottom"><p>© 2026 · Демо-концепт для портфолио.<br/>Компания, адрес, цены и кейсы вымышлены. Фотографии сгенерированы.</p><a href={`${baseUrl}admin/`}>Управление контентом ↗</a></div></footer>
<dialog id="case-dialog"><button class="dialog-close" aria-label="Закрыть подробности">×</button><img id="dialog-image" src="" alt=""/><div class="dialog-content"><p class="eyebrow" id="dialog-car"></p><h2 id="dialog-title"></h2><dl><dt>С чем обратились</dt><dd id="dialog-problem"></dd><dt>Что сделали</dt><dd id="dialog-solution"></dd><dt>Результат</dt><dd id="dialog-result"></dd></dl><p class="fine-print">Вымышленный кейс для демонстрации сайта.</p><a href="#booking" class="button orange" id="dialog-book">Обсудить похожую задачу ↗</a></div></dialog>
<script define:vars={{cases:casesWithBase}}>
const menu=document.querySelector('.menu-toggle'); const nav=document.querySelector('#navigation');
menu.addEventListener('click',()=>{const open=menu.getAttribute('aria-expanded')!=='true';menu.setAttribute('aria-expanded',String(open));menu.setAttribute('aria-label',open?'Закрыть меню':'Открыть меню');nav.classList.toggle('open',open)});
nav.querySelectorAll('a').forEach(a=>a.addEventListener('click',()=>{nav.classList.remove('open');menu.setAttribute('aria-expanded','false');menu.setAttribute('aria-label','Открыть меню')}));
document.addEventListener('keydown',e=>{if(e.key==='Escape'){nav.classList.remove('open');menu.setAttribute('aria-expanded','false');menu.setAttribute('aria-label','Открыть меню')}});
document.querySelectorAll('[data-service]').forEach(a=>a.addEventListener('click',()=>{document.querySelector('select[name=service]').value=a.dataset.service}));
document.querySelectorAll('[data-filter]').forEach(button=>button.addEventListener('click',()=>{document.querySelectorAll('[data-filter]').forEach(b=>b.setAttribute('aria-pressed',String(b===button)));document.querySelectorAll('.work-card').forEach(card=>{card.hidden=button.dataset.filter!=='Все работы'&&card.dataset.category!==button.dataset.filter})}));
const dialog=document.querySelector('#case-dialog');
document.querySelectorAll('[data-case]').forEach(button=>button.addEventListener('click',()=>{const item=cases[Number(button.dataset.case)];for(const key of ['car','title','problem','solution','result'])document.querySelector('#dialog-'+key).textContent=item[key];const img=document.querySelector('#dialog-image');img.src=item.image;img.alt=item.alt;dialog.showModal()}));
document.querySelector('.dialog-close').addEventListener('click',()=>dialog.close());document.querySelector('#dialog-book').addEventListener('click',()=>dialog.close());dialog.addEventListener('click',e=>{if(e.target===dialog){const r=dialog.getBoundingClientRect();if(e.clientX<r.left||e.clientX>r.right||e.clientY<r.top||e.clientY>r.bottom)dialog.close()}});
const form=document.querySelector('#booking-form'), result=document.querySelector('#form-result');form.addEventListener('submit',e=>{e.preventDefault();const digits=form.elements.phone.value.replace(/\D/g,'');if(digits.length<10){form.elements.phone.setCustomValidity('Введите не менее 10 цифр');form.elements.phone.reportValidity();return}form.reset();result.hidden=false;result.focus()});form.elements.phone.addEventListener('input',()=>form.elements.phone.setCustomValidity(''));document.querySelector('#form-reset').addEventListener('click',()=>{result.hidden=true;form.elements.name.focus()});
if('IntersectionObserver' in window&&!matchMedia('(prefers-reduced-motion: reduce)').matches){const observer=new IntersectionObserver(entries=>entries.forEach(entry=>{if(entry.isIntersecting){entry.target.classList.add('visible');observer.unobserve(entry.target)}}),{threshold:.08});document.querySelectorAll('.reveal').forEach(el=>{el.classList.add('will-reveal');observer.observe(el)})}
</script>
</body></html>
